@model EM.Web.Models.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar - FazerBemFazBemTambém</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="tela-login">
        <div class="cartao-login">
            <div class="text-center mb-4">
                <h1 class="page-title">FazerBemFazBemTambém</h1>
                <p class="page-desc">Entre para acessar o sistema.</p>
            </div>

            <form asp-controller="Conta" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"
                     style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="mb-3">
                    <label asp-for="Login" class="form-label">Usuário</label>
                    <input asp-for="Login" class="form-control" autofocus autocomplete="username" />
                </div>

                <div class="mb-3">
                    <label asp-for="Senha" class="form-label">Senha</label>
                    <input asp-for="Senha" type="password" class="form-control" autocomplete="current-password" />
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Lembrar" type="checkbox" class="form-check-input" />
                    <label asp-for="Lembrar" class="form-check-label" style="font-size:.9rem;">
                        Manter conectado neste computador
                    </label>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                </button>
            </form>
        </div>
    </div>
</body>
</html>
