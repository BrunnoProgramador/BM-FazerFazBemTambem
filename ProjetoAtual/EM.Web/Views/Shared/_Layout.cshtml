<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FazerBemFazBemTambém</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EM.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var controllerAtual = (ViewContext.RouteData.Values["controller"] as string) ?? "";
        var actionAtual = (ViewContext.RouteData.Values["action"] as string) ?? "";

        string Ativo(string controller) =>
            string.Equals(controllerAtual, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    <div class="app">

        <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebarMenu" aria-label="Menu principal">
            <a class="sidebar-marca" asp-controller="Dashboard" asp-action="Index">
                <span>FazerBemFazBemTambém</span>
            </a>

            <nav class="sidebar-nav">
                <a class="sidebar-item @Ativo("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-house"></i> Dashboard
                </a>

                <div class="sidebar-grupo">Dia a dia</div>

                <a class="sidebar-item @Ativo("Encontro")" asp-controller="Encontro" asp-action="Index">
                    <i class="bi bi-check2-square"></i> Frequência
                </a>

                <a class="sidebar-item @Ativo("Aluno")" asp-controller="Aluno" asp-action="Index">
                    <i class="bi bi-mortarboard"></i> Alunos
                </a>
                @if (string.Equals(controllerAtual, "Aluno", StringComparison.OrdinalIgnoreCase))
                {
                    <a class="sidebar-subitem @(actionAtual.Equals("Edite", StringComparison.OrdinalIgnoreCase) ? "" : "active")"
                       asp-controller="Aluno" asp-action="Index">Lista</a>
                    <a class="sidebar-subitem @(actionAtual.Equals("Edite", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       asp-controller="Aluno" asp-action="Edite">Novo aluno</a>
                }

                <a class="sidebar-item @Ativo("Turma")" asp-controller="Turma" asp-action="Index">
                    <i class="bi bi-people"></i> Turmas
                </a>

                <div class="sidebar-grupo">Projeto</div>

                <a class="sidebar-item @Ativo("Evento")" asp-controller="Evento" asp-action="Index">
                    <i class="bi bi-calendar-event"></i> Eventos
                </a>

                <a class="sidebar-item @Ativo("Voluntario")" asp-controller="Voluntario" asp-action="Index">
                    <i class="bi bi-heart"></i> Voluntários
                </a>

                <a class="sidebar-item @Ativo("Doacao")" asp-controller="Doacao" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Doações
                </a>

                <a class="sidebar-item @Ativo("Relatorio")" asp-controller="Relatorio" asp-action="Index">
                    <i class="bi bi-graph-up"></i> Relatórios
                </a>

                @if (User.HasClaim("admin", "1"))
                {
                    <div class="sidebar-grupo">Sistema</div>

                    <a class="sidebar-item @Ativo("Usuario")" asp-controller="Usuario" asp-action="Index">
                        <i class="bi bi-gear"></i> Configurações
                    </a>
                }
            </nav>

            <div class="sidebar-rodape">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="sidebar-usuario">
                        <span class="nome" title="@User.Identity.Name">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                        </span>
                        <form asp-controller="Conta" asp-action="Sair" method="post" class="m-0">
                            <button type="submit" class="btn-icone" title="Sair do sistema">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <text>&copy; 2026 FazerBemFazBemTambém</text>
                }
            </div>
        </aside>

        <div class="app-main">

            <div class="topbar">
                <button class="btn btn-icone" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu"
                        aria-controls="sidebarMenu" aria-label="Abrir menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="topbar-titulo">FazerBemFazBemTambém</span>
            </div>

            <main role="main" class="app-conteudo">

                @* Pesquisa rápida de alunos, disponível em todas as telas *@
                <div class="busca-global">
                    <i class="bi bi-search"></i>
                    <input type="text" id="buscaGlobal" class="form-control" autocomplete="off"
                           placeholder="Pesquisar aluno pelo nome..." aria-label="Pesquisar aluno" />
                    <div class="busca-resultados d-none" id="buscaGlobalResultados"></div>
                </div>

                @if (TempData["Sucesso"] is string sucesso)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-1"></i> @sucesso
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                    </div>
                }
                @if (TempData["Erro"] is string erro)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i> @erro
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <div class="app-rodape">
                FazerBemFazBemTambém &middot; sistema de gestão do projeto
            </div>
        </div>
    </div>

    @* Formulário único usado pelos botões de ação POST (exclusões, vínculos) *@
    <form id="formPost" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ── Pesquisa rápida (busca global de alunos) ──
        (function () {
            const campo = document.getElementById("buscaGlobal");
            const caixa = document.getElementById("buscaGlobalResultados");
            const urlBusca = '@Url.Action("BuscarPorNome", "Aluno")';
            const urlPerfil = '@Url.Action("Perfil", "Aluno")';
            let debounce;

            campo.addEventListener("input", () => {
                clearTimeout(debounce);
                const termo = campo.value.trim();
                if (termo.length < 2) {
                    caixa.classList.add("d-none");
                    return;
                }
                debounce = setTimeout(() => buscar(termo), 250);
            });

            async function buscar(termo) {
                try {
                    const resp = await fetch(`${urlBusca}?nome=${encodeURIComponent(termo)}`);
                    const alunos = await resp.json();
                    render(alunos.slice(0, 8));
                } catch (e) {
                    console.error("Erro na pesquisa rápida:", e);
                }
            }

            function render(alunos) {
                if (alunos.length === 0) {
                    caixa.innerHTML = '<div class="sem-resultado">Nenhum aluno encontrado.</div>';
                } else {
                    caixa.innerHTML = alunos.map(a => `
                        <a href="${urlPerfil}/${a.matricula}">
                            <span>${escHtml(a.nome)}</span>
                            <span class="badge-suave ${a.statusCodigo === 0 ? "badge-verde" : "badge-cinza"}">${escHtml(a.status)}</span>
                        </a>`).join("");
                }
                caixa.classList.remove("d-none");
            }

            document.addEventListener("click", e => {
                if (!campo.contains(e.target) && !caixa.contains(e.target)) {
                    caixa.classList.add("d-none");
                }
            });

            campo.addEventListener("keydown", e => {
                if (e.key === "Escape") caixa.classList.add("d-none");
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
