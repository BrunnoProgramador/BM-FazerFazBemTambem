@model EM.Web.Models.VoluntarioModel
@{
    bool ehEdicao = Model != null && Model.Codigo > 0;
    ViewData["Title"] = ehEdicao ? "Editar voluntário" : "Novo voluntário";
    var funcoes = new[] { "Professor", "Auxiliar", "Cozinha", "Recepção", "Coordenação", "Outro" };
}

<div class="page-header">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-desc">
            @(ehEdicao ? "Altere os dados do voluntário e salve." : "Cadastre quem ajuda no projeto.")
        </p>
    </div>
</div>

<div class="panel form-painel">
    <div class="panel-body">
        <form asp-controller="Voluntario" asp-action="@(ehEdicao ? "Atualize" : "Gravar")" method="post">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"
                 style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <input type="hidden" asp-for="Codigo" />

            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" placeholder="Nome do voluntário" maxlength="100" />
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label asp-for="Telefone" class="form-label">Telefone <span class="text-muted fw-normal">(opcional)</span></label>
                    <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000" maxlength="20" />
                </div>
                <div class="mb-3 col-md-6">
                    <label asp-for="Funcao" class="form-label">Função <span class="text-muted fw-normal">(opcional)</span></label>
                    <input asp-for="Funcao" class="form-control" list="funcoes"
                           placeholder="Professor, Auxiliar, Cozinha..." maxlength="50" />
                    <datalist id="funcoes">
                        @foreach (var f in funcoes)
                        {
                            <option value="@f"></option>
                        }
                    </datalist>
                </div>
            </div>

            <div class="form-acoes">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Salvar
                </button>
                <a asp-controller="Voluntario" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
