@model EM.Web.Models.TurmaModel
@{
    bool ehEdicao = Model != null && Model.Codigo > 0;
    ViewData["Title"] = ehEdicao ? "Editar turma" : "Nova turma";
    var diasDaSemana = new[] { "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado", "Domingo" };
    var selecionados = Model?.DiasSelecionados ?? new List<string>();
}

<div class="page-header">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-desc">
            @(ehEdicao ? "Altere os dados da turma e salve." : "Preencha os dados para criar uma nova turma.")
        </p>
    </div>
</div>

<div class="panel form-painel">
    <div class="panel-body">
        <form asp-controller="Turma" asp-action="@(ehEdicao ? "Atualize" : "Gravar")" method="post">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"
                 style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <input type="hidden" asp-for="Codigo" />

            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome da turma (grupo)</label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: 6 a 8 anos, Reforço, Artes, Informática..." />
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label asp-for="Ano" class="form-label">Ano letivo</label>
                    <input asp-for="Ano" type="number" class="form-control" min="2000" max="2100" />
                </div>
                <div class="mb-3 col-md-8">
                    <label asp-for="Professor" class="form-label">Professor <span class="text-muted fw-normal">(opcional)</span></label>
                    <input asp-for="Professor" class="form-control" placeholder="Nome do professor responsável" maxlength="100" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Dias da semana <span class="text-muted fw-normal">(opcional)</span></label>
                <div class="dias-semana">
                    @foreach (var dia in diasDaSemana)
                    {
                        var id = $"dia{dia}";
                        <input type="checkbox" name="dias" value="@dia" id="@id"
                               checked="@selecionados.Contains(dia)" />
                        <label for="@id">@dia</label>
                    }
                </div>
            </div>

            <div class="mb-3 col-md-4">
                <label asp-for="Horario" class="form-label">Horário <span class="text-muted fw-normal">(opcional)</span></label>
                <input asp-for="Horario" type="time" class="form-control" />
            </div>

            <div class="form-acoes">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Salvar
                </button>
                <a asp-controller="Turma" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
